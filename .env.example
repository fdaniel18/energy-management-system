# Copy this file to `.env` and adjust the values.
# Every variable has a development default in docker-compose.yml,
# so the stack also starts without a .env file.

# PostgreSQL (shared by all service databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT signing secret used by AuthService (min. 32 characters)
JWT_SECRET=change-me-dev-only-jwt-secret-key-min-32-bytes

# Optional: local Ollama instance used by the support chatbot
OLLAMA_API_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen3:8b
